{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 571,
  "height": 220,
  "data": {
    "url": "data/gold_logie_wins_typed.csv"
  },
  "transform": [
    {
      "aggregate": [
        {
          "op": "count",
          "as": "wins"
        }
      ],
      "groupby": ["decade", "star_type_label"]
    }
  ],
  "encoding": {
    "x": {
      "field": "decade",
      "type": "ordinal",
      "sort": ["1960s", "1970s", "1980s", "1990s", "2000s", "2010s", "2020s"],
      "axis": {
        "labelAngle": 0,
        "title": "Decade of ceremony",
        "labelFontSize": 12
      }
    },
    "y": {
      "field": "star_type_label",
      "type": "ordinal",
      "sort": [
        "Variety & talk show hosts",
        "Drama & soap actors",
        "Comedy performers",
        "News & current affairs",
        "Light entertainment & reality hosts",
        "Special broadcast"
      ],
      "axis": {
        "title": null,
        "labelFontSize": 12,
        "labelLimit": 260
      }
    },
    "tooltip": [
      {
        "field": "decade",
        "title": "Decade"
      },
      {
        "field": "star_type_label",
        "title": "Star type"
      },
      {
        "field": "wins",
        "title": "Gold Logies won"
      }
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#faf7f2",
        "strokeWidth": 2
      },
      "encoding": {
        "color": {
          "field": "wins",
          "type": "quantitative",
          "scale": {
            "range": ["#fdf6e3", "#f3e2a9", "#e8cf7a", "#d9b036", "#b8860b"],
            "domain": [0, 10]
          },
          "legend": {
            "title": "Gold Logies",
            "orient": "top",
            "gradientLength": 120,
            "direction": "horizontal",
            "titleFontSize": 11,
            "labelFontSize": 11
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 14,
        "fontWeight": "bold",
        "color": {
          "expr": "datum.wins >= 6 ? '#ffffff' : '#3b352c'"
        }
      },
      "encoding": {
        "text": {
          "field": "wins",
          "type": "quantitative"
        }
      }
    }
  ],
  "config": {
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "font": "'Georgia', 'Times New Roman', serif",
    "title": {
      "font": "'Georgia', 'Times New Roman', serif",
      "color": "#3b352c",
      "subtitleColor": "#8a8072"
    },
    "axis": {
      "domainColor": "#c9c2b8",
      "tickColor": "#c9c2b8"
    }
  }
}
